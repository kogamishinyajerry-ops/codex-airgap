# New API 网关地址 (内网)
NEWAPI_BASE_URL=http://10.136.232.50/v1

# New API Key (向 IT 申请)
# 注意: 该 key 严禁 push 到 git! .env 已加 .gitignore
NEWAPI_API_KEY=<YOUR_NEWAPI_KEY>

# 模型名 (在 New API 渠道里查实际注册名, 大小写敏感)
NEWAPI_MODEL=GLM-5.1-AWQ-4bit

# ---- 可选: 气隙隔离开关 (run.bat 已硬编码兜底) ----
# OPENCODE_DISABLE_TELEMETRY=1
# DO_NOT_TRACK=1
# NO_COLOR=1
