{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "newapi": {
      "name": "New API (custom model name)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "YOUR_MODEL_NAME": {}
      },
      "options": {
        "baseURL": "http://YOUR_NEWAPI_HOST:PORT/v1",
        "apiKey": "{env:NEWAPI_API_KEY}"
      }
    }
  },
  "model": "newapi/YOUR_MODEL_NAME",
  "small_model": "newapi/YOUR_MODEL_NAME"
}
